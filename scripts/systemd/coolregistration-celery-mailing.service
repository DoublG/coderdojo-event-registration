# Celery for coolregistration: the mailing worker (default queue: sending mail, anything not scheduled).
# A systemd *user* unit, installed (and restarted) by scripts/deploy.sh into
# ~/.config/systemd/user/ on every deploy.
# Design: DATA_MODEL.md §11, "Production: two Celery workers under systemd".
# The settings read ~/app/.env themselves, so no EnvironmentFile= here.

[Unit]
Description=coolregistration Celery mailing worker
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/app
# %%h is Celery's own hostname placeholder (a literal %h after systemd's
# specifier expansion). Concurrency 1, children recycled at 100 tasks or
# ~200 MB: the workers share the machine's memory with gunicorn.
ExecStart=%h/.pyenv/versions/py10102-3.14.7/bin/python -m celery -A website worker -n mailing@%%h -Q celery -c 1 --max-tasks-per-child 100 --max-memory-per-child 200000 -l INFO
Restart=always
RestartSec=5
# SIGTERM is Celery's warm shutdown: finish the task in hand, take no new
# ones. Longer than the slowest mail batch.
KillSignal=SIGTERM
TimeoutStopSec=120
# Web requests first under CPU pressure.
Nice=10

[Install]
WantedBy=default.target
