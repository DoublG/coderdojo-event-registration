SECRET_KEY=xxx

ALLOWED_HOSTS=xx,yyy,zzz

DB_NAME=xx
DB_USER=xx
DB_PASSWORD=xx
DB_HOST=xxx
DB_PORT=xx

CSRF_TRUSTED_ORIGINS=xx,yyy,zzz

COOKIE_DOMAIN=xxx

EMAIL_HOST=xx
EMAIL_HOST_USER=xx
EMAIL_HOST_PASSWORD=xx

REDIS_HOST=xx

# Links in mails are built from this (no request in a Celery worker).
SITE_URL=https://xx

# The bounce mailbox (mailing.bounce). Empty host = bounce processing off.
MAILING_BOUNCE_ADDRESS=bounces@xx
MAILING_BOUNCE_IMAP_HOST=xx
MAILING_BOUNCE_IMAP_USER=xx
MAILING_BOUNCE_IMAP_PASSWORD=xx

# HTTPS (settings.py; MAINTENANCE.md, security log). Turn the redirect on once
# the proxy is known to send X-Forwarded-Proto, then raise HSTS step by step:
# 3600 (an hour), 86400 (a day), 31536000 (a year). A browser that has seen it
# keeps using https only for that long, so only go up when all is well.
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=false

# Monitoring (CAPACITY.md, "Watching production"): /metrics/ answers only with
# this as a bearer token (generate a long random one); empty = no /metrics/.
METRICS_TOKEN=
