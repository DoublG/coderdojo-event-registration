{
  "name": "coolregistration",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",

  "postCreateCommand": "bash .devcontainer/start.sh",

  // No port forwarding: the only way in is nginx on 443, at
  // https://coolregistration.localhost (start.sh prints every address). VS Code
  // would otherwise auto-forward runserver's 8000 to localhost:8000, which skips
  // nginx (no TLS, /mails/, /otp/, WebSockets) and fails ALLOWED_HOSTS checks.
  "otherPortsAttributes": { "onAutoForward": "ignore" },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "batisteo.vscode-django",
        "mechatroner.rainbow-csv",
        "Anthropic.claude-code"
      ]
    }
  }
}
