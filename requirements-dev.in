# Local development: everything in requirements.in plus tools and libraries
# that only run on a developer machine / in the .devcontainer, never on the
# production server.
#
# This is the source: edit it, then run scripts/compile_requirements.sh, which
# writes requirements-dev.txt from it with every package's hashes (pip-compile from pip-tools;
# commit both). Never edit requirements-dev.txt by hand. pip then installs only files whose
# hash matches (MAINTENANCE.md, "Hash-checked installs").
#
-r requirements.in

# Dependency tools: pip-compile (scripts/compile_requirements.sh) and pip-audit
# (MAINTENANCE.md); their own dependencies are pinned in requirements-dev.txt.
pip-tools==7.6.2
pip-audit==2.10.1

