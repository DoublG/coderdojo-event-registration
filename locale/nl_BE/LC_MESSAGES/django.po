#: accounts/templates/accounts/security_login_method.html:10
#, python-format
msgid ""
"We've mailed <strong>%(email)s</strong> a link to confirm it. Open it within "
"%(hours)s hours. Nothing changes until you do, so if the mail never arrives, "
"you keep your password."
msgstr ""
"We mailden <strong>%(email)s</strong> een link om het te bevestigen. Open "
"hem binnen %(hours)s uur. Tot dan verandert er niets, dus als de mail nooit "
"aankomt, hou je je wachtwoord."

