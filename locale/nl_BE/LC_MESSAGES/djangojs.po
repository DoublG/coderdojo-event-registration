#: core/static/core/js/bundle.js:205
msgid "Sending…"
msgstr "Versturen…"

#: core/static/core/js/bundle.js:209
msgid "Link resent."
msgstr "Link opnieuw verstuurd."

#: core/static/core/js/bundle.js:374 core/static/core/js/bundle.js:375
msgid "Unpin sidebar"
msgstr "Zijbalk losmaken"

#: core/static/core/js/bundle.js:374 core/static/core/js/bundle.js:375
msgid "Pin sidebar open"
msgstr "Zijbalk vastzetten"

#: core/static/core/js/bundle.js:378
msgid "Unpin the sidebar to hide it"
msgstr "Maak de zijbalk los om hem te verbergen"

#: core/static/core/js/bundle.js:515
msgid "Your browser doesn't support location lookup."
msgstr "Je browser ondersteunt het opzoeken van je locatie niet."

#: core/static/core/js/bundle.js:520
msgid "Locating…"
msgstr "Locatie zoeken…"

#: core/static/core/js/bundle.js:539
msgid ""
"Couldn't get your location — check your browser's location permission for "
"this site and try again."
msgstr ""
"We konden je locatie niet ophalen. Kijk de locatietoestemming van je browser "
"voor deze site na en probeer opnieuw."

#: core/static/core/js/bundle.js:617
msgid ""
"This browser can't use passkeys. Try another browser, or another way to "
"confirm it's you."
msgstr ""
"Deze browser kan geen toegangssleutels gebruiken. Probeer een andere browser,"
" of een andere manier om te bevestigen dat jij het bent."

#: core/static/core/js/bundle.js:654
msgid "No passkey was made. You can try again."
msgstr "Er is geen toegangssleutel gemaakt. Je kan het opnieuw proberen."

#: core/static/core/js/bundle.js:655
msgid ""
"Your passkey wasn't used. Try again, or use another way to confirm it's you."
msgstr ""
"Je toegangssleutel is niet gebruikt. Probeer opnieuw, of bevestig op een "
"andere manier dat jij het bent."
